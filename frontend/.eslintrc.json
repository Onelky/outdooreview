{
  "parser": "@typescript-eslint/parser",
  "extends": ["next/core-web-vitals", "eslint:recommended", "plugin:prettier/recommended", "plugin:react/recommended"],
  "plugins": ["prettier"],
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "rules": {
    "prettier/prettier": "warn",
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "off"
  }
}
